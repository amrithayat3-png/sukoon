# Copy to .env for local development. Never commit .env.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Shown in the UI header and page title. Placeholder brand, change freely.
APP_NAME=Sukoon

# Clinician access keys, comma separated, each at least 16 characters.
# Generate with: npm run keygen
# Required in production. In development a built-in key is used if this is empty.
CLINICIAN_KEYS=

# Sessions are erased automatically after this many hours (max 168).
SESSION_TTL_HOURS=24

# memory: sessions vanish on restart (recommended for pilots).
# file: sessions persist as JSON under DATA_DIR (needs a volume on Railway).
STORE_DRIVER=memory
DATA_DIR=./data

# Requests per minute per IP.
RATE_LIMIT_PER_MINUTE=300

# Reserved for the AI pillar (RAG, LangChain, RAGAS). Leave false until adapters are wired.
AI_ENABLED=false

# redis: sessions live in a Redis REST store (Upstash). Required on Vercel, where memory does not persist.
# Vercel Marketplace Upstash sets KV_REST_API_URL and KV_REST_API_TOKEN, which are picked up automatically.
# STORE_DRIVER=redis
# REDIS_REST_URL=
# REDIS_REST_TOKEN=

# OPEN_ACCESS=true skips the access key screen. Anyone with the link can run sessions.
# OPEN_ACCESS=false

# Seals answers and aliases (AES-256-GCM) before they are stored. 32+ random characters. Keep it safe: losing it makes stored sessions unreadable.
SESSION_ENCRYPTION_KEY=
# Sessions one key (or all open-access visitors together) may start per hour. 0 turns the limit off.
SESSION_CREATE_LIMIT_PER_HOUR=120

# ---- SaaS mode: institutes with their own psychologist accounts ----
# SAAS_MODE=true turns on sign-up with invite codes, sign-in, plan limits and the admin page (#/admin).
# It needs STORE_DRIVER=redis in production so accounts survive restarts.
SAAS_MODE=false
# Signs login tokens. 32+ random characters. Changing it signs everyone out.
AUTH_SECRET=
# Your admin key for the institute admin page. 16+ random characters. Keep it private.
ADMIN_KEY=

# Hide activities until a psychologist marks them reviewed (true/false)
ONLY_REVIEWED_PACKS=false
