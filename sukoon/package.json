{
  "name": "sukoon",
  "version": "0.1.0",
  "description": "Session companion platform for licensed psychologists: interactive check-ins and scenario activities with a modular, extensible core.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test test/*.test.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "keygen": "node scripts/keygen.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run validate:content",
    "test:watch": "tsx --test --watch test/*.test.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^8.0.0",
    "fastify": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
